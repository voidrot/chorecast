{
  "components": {
    "schemas": {
      "CompleteSetupOutputBody": {
        "additionalProperties": false,
        "properties": {
          "userId": {
            "description": "The new owner",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "userId"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "HealthOutputBody": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "MeOutputBody": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "description": "What kind of caller this is",
            "enum": [
              "parent",
              "kid",
              "shared_device",
              "display",
              "api"
            ],
            "type": "string"
          },
          "owner": {
            "description": "Parent with owner rights (server settings)",
            "type": "boolean"
          },
          "scopes": {
            "description": "Granted scopes, for clients to hide what the caller can't do",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "userId": {
            "description": "The parent or kid; absent for shared devices, displays and API keys",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "kind",
          "owner",
          "scopes"
        ],
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "Stable machine-readable error code. Clients should branch on this, not on detail.",
            "examples": [
              "kid_not_found"
            ],
            "type": "string"
          },
          "detail": {
            "description": "Human-readable explanation of this occurrence.",
            "examples": [
              "No kid matches \"sam\"."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Individual problems, e.g. one per invalid field.",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "instance": {
            "description": "A URI reference identifying this occurrence.",
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code.",
            "examples": [
              404
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "Short summary of the problem type.",
            "examples": [
              "Not Found"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference identifying the problem type.",
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "type": "object"
      },
      "SetupHousehold": {
        "additionalProperties": false,
        "properties": {
          "dayEnd": {
            "default": "00:00",
            "description": "When the household's day ends (HH:MM); 00:00 means midnight",
            "examples": [
              "00:00"
            ],
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "type": "string"
          },
          "name": {
            "examples": [
              "The Bradys"
            ],
            "maxLength": 60,
            "minLength": 1,
            "type": "string"
          },
          "timezone": {
            "description": "IANA timezone",
            "examples": [
              "America/Chicago"
            ],
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "weekStart": {
            "default": "monday",
            "enum": [
              "sunday",
              "monday",
              "tuesday",
              "wednesday",
              "thursday",
              "friday",
              "saturday"
            ],
            "type": "string"
          }
        },
        "required": [
          "name",
          "timezone",
          "dayEnd",
          "weekStart"
        ],
        "type": "object"
      },
      "SetupKid": {
        "additionalProperties": false,
        "properties": {
          "birthDate": {
            "description": "YYYY-MM-DD; used for age-based chore suggestions",
            "format": "date",
            "type": "string"
          },
          "color": {
            "examples": [
              "#3b82f6"
            ],
            "pattern": "^#[0-9a-fA-F]{6}$",
            "type": "string"
          },
          "displayName": {
            "description": "Nickname or first name",
            "examples": [
              "Sam"
            ],
            "maxLength": 40,
            "minLength": 1,
            "type": "string"
          },
          "pinRequired": {
            "description": "Require a PIN to open this kid's profile on shared devices",
            "type": "boolean"
          }
        },
        "required": [
          "displayName",
          "color"
        ],
        "type": "object"
      },
      "SetupOwner": {
        "additionalProperties": false,
        "properties": {
          "displayName": {
            "examples": [
              "Mom"
            ],
            "maxLength": 40,
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 8,
            "type": "string"
          },
          "username": {
            "description": "3-32 lowercase letters, digits, dot, underscore or hyphen",
            "examples": [
              "mom"
            ],
            "pattern": "^[a-z0-9][a-z0-9._-]{2,31}$",
            "type": "string"
          }
        },
        "required": [
          "displayName",
          "username",
          "password"
        ],
        "type": "object"
      },
      "SetupRequest": {
        "additionalProperties": false,
        "properties": {
          "household": {
            "$ref": "#/components/schemas/SetupHousehold"
          },
          "kids": {
            "items": {
              "$ref": "#/components/schemas/SetupKid"
            },
            "maxItems": 20,
            "type": [
              "array",
              "null"
            ]
          },
          "owner": {
            "$ref": "#/components/schemas/SetupOwner"
          },
          "token": {
            "description": "Setup token from the setup link in the server log",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "token",
          "household",
          "owner"
        ],
        "type": "object"
      },
      "SetupStatusOutputBody": {
        "additionalProperties": false,
        "properties": {
          "oidc": {
            "description": "Whether SSO is configured (the owner may sign in with it later)",
            "type": "boolean"
          },
          "required": {
            "description": "True until first-run setup completes",
            "type": "boolean"
          }
        },
        "required": [
          "required",
          "oidc"
        ],
        "type": "object"
      },
      "VerifySetupInputBody": {
        "additionalProperties": false,
        "properties": {
          "token": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "type": "object"
      },
      "VersionOutputBody": {
        "additionalProperties": false,
        "properties": {
          "apiVersion": {
            "examples": [
              1
            ],
            "format": "int64",
            "type": "integer"
          },
          "commit": {
            "type": "string"
          },
          "oidc": {
            "description": "Whether SSO login is available",
            "type": "boolean"
          },
          "version": {
            "examples": [
              "0.1.0"
            ],
            "type": "string"
          }
        },
        "required": [
          "version",
          "commit",
          "apiVersion",
          "oidc"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "description": "Opaque app/device token",
        "scheme": "bearer",
        "type": "http"
      },
      "session": {
        "in": "cookie",
        "name": "chorecast_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Self-hosted chore and behavior system.",
    "title": "Chorecast API",
    "version": "dev"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Liveness and readiness check",
        "tags": [
          "system"
        ]
      }
    },
    "/me": {
      "get": {
        "operationId": "getMe",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "bearer": []
          },
          {
            "session": []
          }
        ],
        "summary": "The authenticated caller: kind, user and granted scopes",
        "tags": [
          "auth"
        ]
      }
    },
    "/setup": {
      "get": {
        "operationId": "getSetupStatus",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupStatusOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Whether first-run setup is still required",
        "tags": [
          "setup"
        ]
      },
      "post": {
        "description": "Creates the household, the first owner and any kids in one transaction, invalidates the setup token and signs the owner in (web session cookie).",
        "operationId": "completeSetup",
        "parameters": [
          {
            "description": "Optional. Retries with the same key and body replay the first response instead of repeating the action (24 h).",
            "in": "header",
            "name": "Idempotency-Key",
            "schema": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompleteSetupOutputBody"
                }
              }
            },
            "description": "Created",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Complete first-run setup",
        "tags": [
          "setup"
        ]
      }
    },
    "/setup/verify": {
      "post": {
        "description": "Lets the wizard reject a stale setup link before any forms are filled in.",
        "operationId": "verifySetupToken",
        "parameters": [
          {
            "description": "Optional. Retries with the same key and body replay the first response instead of repeating the action (24 h).",
            "in": "header",
            "name": "Idempotency-Key",
            "schema": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifySetupInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Check a setup token without using it",
        "tags": [
          "setup"
        ]
      }
    },
    "/version": {
      "get": {
        "operationId": "getVersion",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Server and API version (used by clients for compatibility checks)",
        "tags": [
          "system"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ]
}
