{
  "components": {
    "schemas": {
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "HealthOutputBody": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "/api/v1/schemas/HealthOutputBody.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "/api/v1/schemas/Problem.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "code": {
            "description": "Stable machine-readable error code. Clients should branch on this, not on detail.",
            "examples": [
              "kid_not_found"
            ],
            "type": "string"
          },
          "detail": {
            "description": "Human-readable explanation of this occurrence.",
            "examples": [
              "No kid matches \"sam\"."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Individual problems, e.g. one per invalid field.",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "instance": {
            "description": "A URI reference identifying this occurrence.",
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code.",
            "examples": [
              404
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "Short summary of the problem type.",
            "examples": [
              "Not Found"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference identifying the problem type.",
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "type": "object"
      },
      "VersionOutputBody": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "/api/v1/schemas/VersionOutputBody.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "apiVersion": {
            "examples": [
              1
            ],
            "format": "int64",
            "type": "integer"
          },
          "commit": {
            "type": "string"
          },
          "oidc": {
            "description": "Whether SSO login is available",
            "type": "boolean"
          },
          "version": {
            "examples": [
              "0.1.0"
            ],
            "type": "string"
          }
        },
        "required": [
          "version",
          "commit",
          "apiVersion",
          "oidc"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "description": "Opaque app/device token",
        "scheme": "bearer",
        "type": "http"
      },
      "session": {
        "in": "cookie",
        "name": "chorecast_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Self-hosted chore and behavior system.",
    "title": "Chorecast API",
    "version": "dev"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Liveness and readiness check",
        "tags": [
          "system"
        ]
      }
    },
    "/version": {
      "get": {
        "operationId": "getVersion",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Server and API version (used by clients for compatibility checks)",
        "tags": [
          "system"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ]
}
